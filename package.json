{
  "name": "@clm-framework/clm-core",
  "version": "1.2.30",
  "description": "Core module of the Common Learning Middleware (CLM): user, group, role and permission management, JWT/OIDC authentication and the shared relation model for CLM extension services.",
  "main": "dist/lib/CoreLib.js",
  "types": "dist/lib/CoreLib.d.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf ./dist && npx tsc",
    "prepare": "npm run build",
    "docker:build": "docker build -t clm-core:latest .",
    "build-docs": "tsc && api-extractor run --local && api-documenter markdown --input-folder api-extractor --output-folder docs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "clm",
    "learning-middleware",
    "lti",
    "oidc",
    "rbac",
    "express"
  ],
  "author": "Fraunhofer FOKUS",
  "license": "AGPL-3.0",
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "cryptr": "^6.0.3",
    "dotenv": "^16.0.0",
    "ejs": "^6.0.1",
    "express": "^4.17.3",
    "express-list-endpoints": "^6.0.0",
    "express-validator": "^6.14.0",
    "ioredis": "^5.2.3",
    "js-yaml": "^5.2.3",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.9.8",
    "neo4j-driver": "^4.4.5",
    "nodemailer": "^10.0.13",
    "nodemailer-pug-engine": "^2.0.1",
    "passport": "^0.7.0",
    "passport-http": "^0.3.0",
    "passport-local": "^1.0.0",
    "pg": "^8.12.0",
    "swagger-jsdoc": "^6.3.0",
    "url-pattern": "^1.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.12",
    "@types/crypto-js": "^4.1.1",
    "@types/cryptr": "^4.0.1",
    "@types/express": "^4.17.13",
    "@types/express-list-endpoints": "^6.0.0",
    "@types/js-yaml": "^4.0.5",
    "@types/jsonwebtoken": "^8.5.8",
    "@types/node": "^17.0.26",
    "@types/nodemailer": "^6.4.4",
    "@types/passport": "^1.0.16",
    "@types/passport-http": "^0.3.9",
    "@types/passport-local": "^1.0.34",
    "@types/pg": "^8.11.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "^13.0.6",
    "minimatch": "10.2.4",
    "qs": "6.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fraunhoferfokus/clm-core.git"
  }
}
